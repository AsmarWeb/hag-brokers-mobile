{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://hagbrokers.net",
        "EXPO_PUBLIC_ALLOW_LOCAL_HTTP": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://hagbrokers.net",
        "EXPO_PUBLIC_ALLOW_LOCAL_HTTP": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
