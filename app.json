{
  "expo": {
    "name": "HAG Brokers",
    "slug": "hag-brokers-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/hag-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "hagbrokers",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.hagbrokers.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "net.hagbrokers.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/hag-adaptive-icon.png",
        "backgroundColor": "#09131F"
      },
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HAG Brokers to access the photos and videos you choose for an opportunity.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#D9B879",
          "defaultChannel": "business-updates"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a6466f8f-367c-4b00-93aa-b7c8a65be477"
      }
    },
    "owner": "asmarweb"
  }
}
